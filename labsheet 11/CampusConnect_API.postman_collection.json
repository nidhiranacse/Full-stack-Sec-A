{
  "info": {
    "_postman_id": "campusconnect-fullstack-2026",
    "name": "CampusConnect - Student Event & Resource Management Portal API",
    "description": "Comprehensive Postman Collection covering Authentication, Role-Based Access Control, Events Management, Student Registrations, File Uploads/Downloads, and Dashboards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vanshika Chauhan\",\n  \"email\": \"student@campusconnect.edu\",\n  \"password\": \"Student@123\",\n  \"role\": \"student\",\n  \"studentId\": \"CU240250953\",\n  \"department\": \"Computer Science & Engineering\",\n  \"semester\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login as Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@campusconnect.edu\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('adminToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusconnect.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Events Module",
      "item": [
        {
          "name": "Get Events (Search, Category & Pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/events?search=react&category=Workshop&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "search", "value": "react" },
                { "key": "category", "value": "Workshop" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Event Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Create Event (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native & DevOps Workshop\",\n  \"description\": \"Comprehensive microservices and container orchestration session with Kubernetes.\",\n  \"category\": \"Workshop\",\n  \"date\": \"2026-11-15T10:00:00.000Z\",\n  \"time\": \"10:00 AM - 04:00 PM\",\n  \"venue\": \"Auditorium B, Tech Block\",\n  \"maxSeats\": 60,\n  \"organizer\": \"CSE Department\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Register for Event (Student)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "register"]
            }
          }
        },
        {
          "name": "Unregister from Event (Student)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/unregister",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "unregister"]
            }
          }
        },
        {
          "name": "Get Event Attendees List (Admin Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/attendees",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "attendees"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Academic Resources",
      "item": [
        {
          "name": "Get Resources (Filter & Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources?semester=5&category=Notes&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["resources"],
              "query": [
                { "key": "semester", "value": "5" },
                { "key": "category", "value": "Notes" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Resource Filter Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources/meta",
              "host": ["{{baseUrl}}"],
              "path": ["resources", "meta"]
            }
          }
        },
        {
          "name": "Download Resource File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources/{{resourceId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["resources", "{{resourceId}}", "download"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboards",
      "item": [
        {
          "name": "Student Dashboard (My Events & Registrations)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/student",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "student"]
            }
          }
        },
        {
          "name": "Admin Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/dashboard/admin",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "admin"]
            }
          }
        }
      ]
    }
  ]
}
