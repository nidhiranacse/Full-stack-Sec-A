          "name": "Register for Event (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["events", "1", "register"]
