            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Web Development Workshop: MERN & Next.js (Updated)\",\n  \"description\": \"Upgraded masterclass covering Next.js 15, React Server Components, and TailwindCSS design systems.\",\n  \"category\": \"Workshop\",\n  \"date\": \"2026-10-06\",\n  \"time\": \"10:00 AM - 02:00 PM\",\n  \"venue\": \"Seminar Hall 3, Block B\",\n  \"maxSeats\": 75\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/1",
