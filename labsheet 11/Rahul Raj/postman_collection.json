    {
      "name": "2. Events Module",
      "item": [
        {
          "name": "Get All Events (Search, Category & Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?page=1&limit=10&category=All&q=",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "category", "value": "All" },
                { "key": "q", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Filter Events by Category (Workshop)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?category=Workshop",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "category", "value": "Workshop" }
              ]
            }
          }
        },
        {
          "name": "Get Single Event Details & Seat Status",
          "request": {
            "method": "GET",
