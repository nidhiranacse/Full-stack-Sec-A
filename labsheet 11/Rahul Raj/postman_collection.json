  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Health check and system metadata verification"
      }
    },
    {
      "name": "1. Authentication",
      "item": [
