              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Aditya\",\n  \"email\": \"vikram.aditya@campus.edu\",\n  \"password\": \"SecurePass@123\",\n  \"role\": \"student\",\n  \"department\": \"Computer Science & Engineering\",\n  \"semester\": \"Semester 6\"\n}"
